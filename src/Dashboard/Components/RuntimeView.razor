@implements IAsyncDisposable
@inject RuntimeLoader Loader
@inject IJSRuntime JS

@* The runtime view: the environment's C4 deployment diagram, rendered by PlantUML at deploy time, updated in place
   from the same monitor as the health view (js/runtime.js draws; RuntimePayloadBuilder decides what). *@
<section class="runtime" aria-labelledby="runtime-title">
    <header class="runtime__header">
        <h2 id="runtime-title">Runtime@(Current is { } shown ? $": {shown.Name}" : string.Empty)</h2>
        @if (_index?.Index is { } index && index.Environments.Count > 0)
        {
            <div class="runtime__environments" role="group" aria-label="Environment">
                @foreach (var entry in index.Environments)
                {
                    var selected = ReferenceEquals(entry, Current);
                    @* An environment something is being deployed to carries a dot, so it shows while another one is looked at. *@
                    var inFlight = Monitor.DeploymentMarks(entry.Name, [], Now).Where(mark => mark.InFlight).ToList();
                    <button type="button" class="button @(selected ? "button--selected" : "button--quiet")" aria-pressed="@(selected ? "true" : "false")"
                            title="@(inFlight.Count > 0 ? string.Join('\n', inFlight.Select(DeploymentText.Title)) : null)"
                            @onclick="() => SelectAsync(entry.Name)">
                        @entry.Name
                        @if (inFlight.Count > 0)
                        {
                            <DeploymentDot State="inFlight[0].State" />
                            <span class="visually-hidden">: @string.Join("; ", inFlight.Select(mark => mark.Sentence))</span>
                        }
                    </button>
                }
            </div>
            <button type="button" class="button button--quiet runtime__fit"
                    title="@(_fit ? "The diagram is fitted to the width of the page (down to 70 % of its size). Press to show it at its actual size; it then scrolls sideways" : "The diagram is shown at its actual size. Press to fit it to the width of the page (down to 70 % of its size)")"
                    @onclick="() => _fit = !_fit">@(_fit ? "Actual size" : "Fit to width")</button>
            @* What is being deployed to the shown environment: the system's own release marks the environment here, a
               deployable's also the nodes of the diagram. *@
            <DeploymentMarks Marks="Deploying" Activity="@(Current is { } named ? Monitor.EnvironmentActivity(named.Name, Deploying, Now, Zone) : [])"
                             Label="@($"Deployments to {Current?.Name}")" Generated="Monitor.Deployments?.Generated" Zone="Zone" />
        }
    </header>

    @if (_index is null)
    {
        <p class="empty" role="status">Loading the runtime diagrams</p>
    }
    else if (_index.Availability == RuntimeAvailability.NotDeployed)
    {
        <p class="empty runtime__absent" role="status">
            The runtime diagram is not available for this deployment: the site has no <code>runtime/</code> folder. The
            deployment of a newer dashboard release renders it. The Health view shows every node.
        </p>
    }
    else if (_index.Index is not { } loaded)
    {
        <section class="problem" role="alert">
            <h3>The runtime diagrams could not be read</h3>
            <ul>
                @foreach (var error in _index.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </section>
    }
    else if (loaded.Environments.Count == 0)
    {
        <p class="empty">The deployment rendered no runtime diagram: system.json has no environment.</p>
    }
    else
    {
        @if (_diagram is { IsValid: false } broken)
        {
            <section class="problem" role="alert">
                <h3>The runtime diagram of @broken.Environment could not be read</h3>
                <ul>
                    @foreach (var error in broken.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </section>
        }
        else if (_diagram is null)
        {
            <p class="empty" role="status">Loading the runtime diagram of @Current?.Name</p>
        }

        @if (_mountProblem is { } problem)
        {
            <p class="problem" role="alert">@problem</p>
        }

        @* js/runtime.js owns the content of this element: Blazor renders it empty and never touches its children. *@
        <div class="runtime__canvas @(_fit ? "runtime__canvas--fit" : null)" tabindex="0" role="region"
             aria-label="@($"Runtime diagram of {Current?.Name}; scrolls sideways at its actual size")" hidden="@(_diagram is not { IsValid: true })">
            <div class="runtime__svg" @ref="_host"></div>
        </div>

        @if (_missing.Count > 0)
        {
            <p class="runtime__missing" role="status">
                The diagram lacks @string.Join(", ", _missing): the manifest and the SVG of this deployment do not match.
            </p>
        }

        @* Under the diagram: what is known about the shown environment beyond its health (its resources in the Azure
           portal, what the pipeline's hourly health reports found, what it and the resources it shares cost, the code
           its deployables run, how they were delivered), and last the code of the dashboard itself.
           Nothing where no source answered. *@
        @if (Shown is { } facts)
        {
            <section class="runtime__facts" aria-label="@($"Availability, cost, code and delivery of {facts.Name}")">
                <EnvironmentLinks Links="facts.Info.Links" Pages="facts.Info.Pages" Environment="@facts.Name" />
                @if (Monitor.Delivery is { } delivered && delivered.HealthOf(facts.Name) is { } reports)
                {
                    <AvailabilityLine Reports="reports" Label="@($"Availability of {facts.Name}")" Changed="delivered.Generated" Zone="Zone" Now="Now" />
                }
                @if (Monitor.Cost is { } cost)
                {
                    if (cost.Find(facts.Name) is { } spent)
                    {
                        <CostLine Report="cost" Amounts="spent.Amounts" Services="spent.TopServices" Estimate="spent.Estimate" Label="@($"Cost of {facts.Name}")" Now="Now" />
                    }

                    if (cost.Shared is { } shared)
                    {
                        <CostLine Report="cost" Amounts="shared.Amounts" Services="shared.TopServices" Label="Cost of what the environments share" Now="Now" />
                    }
                }
                @{
                    var deployableIndex = 0;
                }
                @foreach (var deployable in facts.Deployables)
                {
                    <DeployableFacts @key="deployable" Monitor="Monitor" Environment="facts" Deployable="deployable"
                                     IdPrefix="@($"runtime-app-{deployableIndex++}")" Zone="Zone" Now="Now" />
                }
                <EnvironmentDelivery Monitor="Monitor" Environment="facts" IdPrefix="runtime" Zone="Zone" Now="Now" />
                <DashboardCode Monitor="Monitor" IdPrefix="runtime-self" Zone="Zone" Now="Now" />
            </section>
        }

        <RuntimeLegend Deployments="Monitor.Topology.System.DeploymentsUrl is not null" />
        @if (loaded.PlantUml is { } version)
        {
            <p class="help">Rendered with PlantUML @version when the dashboard was deployed.</p>
        }
    }
</section>

@code {
    private readonly CancellationTokenSource _stopping = new();
    private readonly Dictionary<string, RuntimeDiagram> _diagrams = new(StringComparer.Ordinal);
    private RuntimeIndexResult? _index;
    private RuntimeDiagram? _diagram;
    private IJSObjectReference? _module;
    private ElementReference _host;
    private RuntimeDiagram? _mounted;
    private string? _lastPayload;
    private string? _mountProblem;
    private List<string> _missing = [];
    private bool _fit = true;

    /// <summary>The monitor of the page: the same checks the health view shows.</summary>
    [Parameter, EditorRequired]
    public DashboardMonitor Monitor { get; set; } = default!;

    /// <summary>The environment the address names; the first one of the index when it names none or an unknown one.</summary>
    [Parameter]
    public string? Environment { get; set; }

    [Parameter]
    public EventCallback<string> EnvironmentChanged { get; set; }

    /// <summary>
    /// Raised when the diagram shows a container app the page never probed, or Resource Health it never read: the page
    /// then checks at once instead of at its next round.
    /// </summary>
    [Parameter]
    public EventCallback ProbesDue { get; set; }

    /// <summary>The page's own address: the static site that serves it is "this page".</summary>
    [Parameter, EditorRequired]
    public Uri Page { get; set; } = default!;

    [Parameter, EditorRequired]
    public TimeZoneInfo Zone { get; set; } = default!;

    /// <summary>The moment of this rendering: "2 h ago" is counted from it.</summary>
    [Parameter]
    public DateTimeOffset Now { get; set; }

    /// <summary>The monitor's environment of the diagram that is shown; null while none is, or when the topology has none of that name.</summary>
    private EnvironmentStatus? Shown => _diagram is { IsValid: true } diagram
        ? Monitor.Environments.FirstOrDefault(status => string.Equals(status.Name, diagram.Manifest!.Environment, StringComparison.OrdinalIgnoreCase))
        : null;

    private RuntimeIndexEntry? Current => _index?.Index?.Environments is { Count: > 0 } entries
        ? entries.FirstOrDefault(entry => string.Equals(entry.Name, Environment, StringComparison.OrdinalIgnoreCase)) ?? entries[0]
        : null;

    /// <summary>
    /// What is being deployed to the shown environment. A mark belongs to a deployable the diagram draws a node of,
    /// also one the topology does not list; while the diagram is not loaded, to none.
    /// </summary>
    private IReadOnlyList<DeploymentMark> Deploying => _diagram is { IsValid: true, Manifest: { } manifest }
        ? Monitor.DeploymentMarks(manifest.Environment, RuntimePayloadBuilder.Deployables(manifest), Now)
        : Current is { } entry ? Monitor.DeploymentMarks(entry.Name, [], Now) : [];

    public async ValueTask DisposeAsync()
    {
        await _stopping.CancelAsync();
        // The container apps are probed only while the runtime view shows them.
        Monitor.Watch(RuntimeWatch.None);
        if (_module is { } module)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away.
            }
        }

        _stopping.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        _index = await Loader.LoadIndexAsync(_stopping.Token);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Current is not { } entry)
        {
            _diagram = null;
            return;
        }

        if (!_diagrams.TryGetValue(entry.Name, out var diagram))
        {
            _diagram = null;
            diagram = await Loader.LoadDiagramAsync(entry, _stopping.Token);
            _diagrams[entry.Name] = diagram;
        }

        _diagram = diagram;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_diagram is not { IsValid: true } diagram)
        {
            Monitor.Watch(RuntimeWatch.None);
            return;
        }

        if (Monitor.Watch(RuntimePayloadBuilder.Watch(diagram.Manifest!)))
        {
            await ProbesDue.InvokeAsync();
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/runtime.js");
        if (!ReferenceEquals(_mounted, diagram))
        {
            _mountProblem = await _module.InvokeAsync<string?>("mount", _host, diagram.Svg);
            _mounted = diagram;
            _lastPayload = null;
            if (_mountProblem is not null)
            {
                StateHasChanged();
            }
        }

        if (_mountProblem is not null)
        {
            return;
        }

        var environment = Shown;
        var shown = diagram.Manifest!.Environment;
        var payload = RuntimePayloadBuilder.Build(
            diagram.Manifest!,
            environment,
            Page,
            Zone,
            Deploying,
            Monitor.Deployments is null ? null : deployable => Monitor.NodeActivity(shown, deployable, Now, Zone),
            Monitor.Delivery,
            Now,
            Monitor.ContainerAppStatusOf,
            Monitor.ResourceHealth).ToJson();
        if (payload == _lastPayload)
        {
            return;
        }

        _lastPayload = payload;
        var missing = (await _module.InvokeAsync<string[]>("update", _host, payload)).ToList();
        if (!missing.SequenceEqual(_missing))
        {
            _missing = missing;
            StateHasChanged();
        }
    }

    private async Task SelectAsync(string environment)
    {
        if (!string.Equals(environment, Current?.Name, StringComparison.Ordinal))
        {
            await EnvironmentChanged.InvokeAsync(environment);
        }
    }
}
